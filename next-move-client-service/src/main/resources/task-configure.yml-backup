    - id: task-06
      type: NONE_CONTROL
      sourceType: HADOOP
      rootPath:
        source: viewfs://blendata/src-local-02/main/submain/none-*/<current_date(ddMMyyyy)>
        #        source: /src-local-02/main/submain/none-src/<current_date(ddMMyyyy)-1>
        #        source: /src-local-02/main/submain/movethis/zero-2
        #        source: /src-local-02/main/submain/mov*/zer*
        destination: viewfs://blendata/dest-local-02/none-dest/<current_date(ddMMyyyy)+1>
      filesPerRound: 100
      #      afterDate: '12/08/2024 08:00:00'
      #      beforeCurrentDateInHours: 5
      #      beforeCurrentDateInDays: 3
      srcExtensions:
        - ctrl
        - txt
        #        - txt.gz
        #        - tar.gz
        #        - txt
        #        - zip
        - Z
      #        - zip
      wildcardPatterns:
        - exam*
        - ocs*
      #        - data-1*
      compression:
        notExtract: false
        createTargetDirectory: false
      overwrite: false
      checkFileSize: true
      checkFileDelaySeconds: 10
      moveType: COPY
      retry: 1
      cronExpression: "0/2 * * ? * * *"


